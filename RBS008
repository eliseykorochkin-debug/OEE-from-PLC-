NETWORK
TITLE =resetto i manuali e seleziono lo stato di funzionamento
// 
// se sono in drenaggio devo avere VM4 = 100% e VM2 =0%
//      L     0.000000e+000               //vm2
//      L     1.000000e+002               //vm4
//      U     #_Drain
//      SPB   M014
// ** gestione apertura VM2 in manuale
      L     #R_Man_VM2; 
      L     #R_Man_VM4; 
      A     #_MA_Pressione; // se settato il manuale automatico da PC
      JC    M014; 
// ** gestione apertura VM4 in CIP
// raggiunto il massimo livello tank prodotto chiudo lo sfiato per evitare
// fuoriuscita del Cip
      L     0.000000e+00; //vm2
      A     #flip_flop_cip_vm4; // tank prodotto pieno
      A     #_CIP_Rinse; 
      JC    S110; 
      L     0.000000e+00; //vm4
      JU    S111; 
S110: L     #R_Sfiato_VM4_Cip; 
      JU    M014; 
S111: NOP   0; 
      L     1.000000e+02; 
      A     #_CIP_Rinse; // se sono in cip o risciacquo riemp.
      A     #_open_100_VM4; 
      AN    #_Start_up; 
      JC    M014; 


// APERTURA IN START UP DELLA VM2 (dopo min.pressione parte il PID solo 
// proporzionale)
      L     #R_VM2_max_start; //vm2
      L     0.000000e+00; //vm4
      A     #_PID_enable; 
      A     #_Start_up; 
//      UN    #_Min_press_OK      // da vedere
      JC    M014; 
// ** gestione apertura VM2 in assenza della produzione
      L     0.000000e+00; //vm2
      L     5.000000e+01; //vm4
      AN    #_PID_enable; 
      A     "M200.5"; 
      JC    M014; 
      L     0.000000e+00; //vm2
      L     0.000000e+00; //vm4
      AN    #_PID_enable; 
      AN    "M200.5"; 
      JC    M014; 
      JU    M013; 
M014: NOP   0; 
      T     #R_Out_VMout; 
      TAK   ; 
      T     #R_Out_VMin; 
      JU    M015; 
M013: NOP   0; 


// controllo uscita regolazioni in automatico.

//;
      L     #R_out_pid; 
      L     5.000000e+01; 
      >R    ; 
      JC    M016; 
// regolazione valvola sfiato VM4
// sottraggo il valore di 50% all'uscita del PID e lo moltiplico *2
// per ottimizzare la risoluzione.
// (VM4=(50-R_OUT_PID)*2)
      TAK   ; 
      -R    ; 
      L     2.000000e+00; 
      *R    ; 
      T     #R_Out_VMout; 
      L     0.000000e+00; 
      T     #R_Out_VMin; 
      JU    M015; 
