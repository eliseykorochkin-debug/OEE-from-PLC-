ORGANIZATION_BLOCK OB 35
TITLE =
VERSION : 0.0


VAR_TEMP
  OB35_EV_CLASS : BYTE ;	//Bits 0-3 = 1 (Coming event), Bits 4-7 = 1 (Event class 1)
  OB35_STRT_INF : BYTE ;	//16#36 (OB 35 has started)
  OB35_PRIORITY : BYTE ;	//11 (Priority of 1 is lowest)
  OB35_OB_NUMBR : BYTE ;	//35 (Organization block 35, OB35)
  OB35_RESERVED_1 : BYTE ;	//Reserved for system
  OB35_RESERVED_2 : BYTE ;	//Reserved for system
  OB35_PHASE_OFFSET : WORD ;	//Phase offset (msec)
  OB35_RESERVED_3 : INT ;	//Reserved for system
  OB35_EXC_FREQ : INT ;	//Frequency of execution (msec)
  OB35_DATE_TIME : DATE_AND_TIME ;	//Date and time OB35 started
  Time_exec : TIME ;	
  Real_OB35_EXC_FREQ : REAL ;	
  Real_sec_in_ms : REAL ;	
  real_Hour_ion_ms : REAL ;	
  seconds_in_cents : INT ;	
  hour_in_cents : DINT ;	
END_VAR
BEGIN
NETWORK
TITLE =

      A     "350K1"; 
      JNB   _001; 
      L     MW    66; 
      L     1; 
      +I    ; 
      T     MW    66; 
_001: NOP   0; 
NETWORK
TITLE =

      L     100; 
      ITD   ; 
      DTR   ; 
      T     #Real_sec_in_ms; 
//
      L     #OB35_EXC_FREQ; 
      ITD   ; 
      DTR   ; 
      T     #Real_OB35_EXC_FREQ; 
//
      L     L#3600000; 
      DTR   ; 
      T     #real_Hour_ion_ms; 
// tempo per il calcolo delle ore di funzionamento
      L     #Real_sec_in_ms; 
      L     #Real_OB35_EXC_FREQ; 
      /R    ; 
      L     1.000000e+01; 
      *R    ; 
      TRUNC ; 
      T     #seconds_in_cents; 
// tempo per il calcolo delle bottiglie ora
      L     #real_Hour_ion_ms; 
      L     #Real_OB35_EXC_FREQ; 
      /R    ; 
      TRUNC ; 
      T     #hour_in_cents; 
NETWORK
TITLE =

      L     MW    66; 
      L     #seconds_in_cents; 
      ==I   ; 
      =     L     42.0; 
      A     L     42.0; 
      BLD   102; 
      =     M    100.0; 
      A     L     42.0; 
      JNB   _002; 
      L     0; 
      T     MW    66; 
_002: NOP   0; 
NETWORK
TITLE =



      A     M    100.0; 
      JNB   _003; 
      L     1; 
      L     "DATA_SET".SECONDS; 
      +I    ; 
      T     "DATA_SET".SECONDS; 
_003: NOP   0; 
NETWORK
TITLE =

      L     "DATA_SET".SECONDS; 
      L     3600; 
      ==I   ; 
      =     L     42.0; 
      A     L     42.0; 
      JNB   _004; 
      L     L#1; 
      L     "PLC TO PV".HOURS; 
      +D    ; 
      T     "PLC TO PV".HOURS; 
_004: NOP   0; 
      A     L     42.0; 
      JNB   _005; 
      L     0; 
      T     "DATA_SET".SECONDS; 
_005: NOP   0; 
NETWORK
TITLE =

      A(    ; 
      L     "PLC TO PV".HOURS; 
      L     L#999999; 
      ==D   ; 
      )     ; 
      JNB   _006; 
      L     0; 
      T     "PLC TO PV".HOURS; 
_006: NOP   0; 
NETWORK
TITLE =

      L     #OB35_EXC_FREQ; 
      T     #Time_exec; 
      CALL FB    25 , DB    25 (
           Tempo_Richiamo           := #Time_exec);

END_ORGANIZATION_BLOCK

