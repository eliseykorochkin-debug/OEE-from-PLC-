END_VAR
VAR_TEMP
  R_temp1 : REAL ;	//valore appoggio reale
  R_temp2 : REAL ;	//valore appoggio reale
  R_K_recupero : REAL ;	//costante di recupero
  R_Set_point : REAL ;	//set point reale per FB41
  R_PV_sonda : REAL ;	//Valore reale della sonda (reale)
  R_PV_livello : REAL ;	//valore reale del livello
  R_K_reset_int : REAL ;	//K reset integrale FF
  R_K_rampa : REAL ;	//K di incremento rampa
  R_Filler_speed : REAL ;	//Valore reale normalizzato speed
  R_VM1_start : REAL ;	//valore reale apertura VM1 start
