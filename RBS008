// analogica uscita VM4. Viene normalizzata a 0-27648

      L     #R_Out_VMout; 
      L     1.000000e+02; 
      /R    ; 
      L     2.764800e+04; 
      *R    ; 
      TRUNC ; 
      T     #OUT_periph_VM4; 

