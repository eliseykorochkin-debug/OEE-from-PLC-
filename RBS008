VAR
  R_VM49_CIP : REAL  := 1.000000e+02;	//apertura valvola VM5 in CIP
  R_Out_VMin : REAL ;	//Reale valvola co2 (VM49)
  R_spare_s3 : REAL ;	
  R_spare_s4 : REAL ;	
  R_spare_s5 : REAL ;	
END_VAR
VAR_TEMP
  R_SP_prod : REAL ;	//set point reale per FB41
  R_SP_PID : REAL ;	//Set point da passare al PID
  R_PV_press : REAL ;	//valore reale della pressione
  R_Filler_speed : REAL ;	//Valore reale normalizzato speed
  R_VM49_start : REAL ;	//valore reale apertura VM5 start
  R_VM49_drain : REAL ;	//Valore reale apertura VM49 in drenaggio
  R_out_pid : REAL ;	//Valore di uscita PID
  R_FF_to_pid : REAL ;	//valore di FF da sommare al PID
  R_KP : REAL ;	//K proporzionale
  TI : TIME ;	//T integrale
  TD : TIME ;	//T derivativo
  R_T_exec : REAL ;	//Tempo di riesecuzione per PID
  R_LMN_OFF : REAL ;	//offset valore di uscita
  R_LMN_FAC : REAL ;	//moltiplicativo valore uscita
  Hold_int_PID : BOOL ;	//hold dell'integrale PID
  RES_int_PID : BOOL ;	//Reset integrale PID FB41
  MAN_ON : BOOL ;	//manuale abilitato al PID
  R_ff_real_pr : REAL ;	//ff pressione reale
  filler_speed_c : WORD ;	//valore ingresso analogico velocita' macchina controllato
  PV_periph_c : WORD ;	//valore ingresso analogico pressione controllato
  R_manual_value : REAL ;	//Valore di manuale impostato
  R_Man_VM49 : REAL ;	//Valore di manuale VM49 impostato da PC
END_VAR
BEGIN
NETWORK
TITLE =verifica limiti ingressi analogici
// velocita' macchina
      L     #Filler_speed; 
      L     W#16#7FFF; 
      >=I   ; 
      JC    M001; 
// 
      L     #Filler_speed; 
      L     0; 
      <=I   ; 
      JC    M001; 
      L     #Filler_speed; 
      L     27648; 
      >=I   ; 
      JC    M002; 
      TAK   ; 
      JU    M002; 
M001: L     0; 
M002: T     #filler_speed_c; 

// valore periferia ingresso pressione
      L     #PV_periph; 
      L     0; 
      <=I   ; 
      JC    M005; 
      L     #PV_periph; 
      L     27648; 
      >=I   ; 
      JC    M006; 
      TAK   ; 
      JU    M006; 
M005: L     0; 
M006: T     #PV_periph_c; 
NETWORK
TITLE =conversione costanti di ingresso da intere a reali
//
//
//
// ** trasforma il set point in valore reale (10.00)
      L     #SP_press; 
      ITD   ; 
      DTR   ; 
      L     1.000000e+02; 
      /R    ; 
      T     #R_SP_prod; 
      T     #R_SP_PID; 
      L     1.000000e+02; 
      *R    ; 
      TRUNC ; 
      T     #PC_SP_USE; 
      NOP   0; 

// ** trasformo la costante VM49_start
//
      L     #VM49_start; 
      ITD   ; 
      DTR   ; 
      T     #R_VM49_start; 

// ** trasformo il valore di forzamento manuale
//
      L     #VM49_man; 
      ITD   ; 
      DTR   ; 
      T     #R_Man_VM49; 

// ** trasformo il valore di forzamento in drenaggio

      L     #VM49_drain; 
      ITD   ; 
      DTR   ; 
      T     #R_VM49_drain; 

// ** trasformo il valore di forzamento in cip o risciacquo

      L     #VM49_cip_rinse; 
      ITD   ; 
      DTR   ; 
      T     #R_VM49_CIP; 

// ** trasformo il valore di velocit� riempitrice
//
      L     #filler_speed_c; 
      ITD   ; 
      DTR   ; 
      L     2.764800e+04; 
      /R    ; 
      T     #R_Filler_speed; 
NETWORK
TITLE =conversione parametri PID da intero a reale 
//
// ** calcolo il fattore proporzionale 
//
      L     #KP_press; // trasferisco parametro proporzionale
      DTR   ; 
      L     1.000000e+02; // eseguo l'operazione 100 / PB
      TAK   ; 
      /R    ; 
      T     #R_KP; 
//
// ** calcolo del fattore integrale
//
      L     #TI_press; // parametri integrale in secondi 
      L     10; 
      *D    ; // * 10 -> trasformo in tempo siemmens mS 
      T     #TI; 
//
// ** calcolo del fattore integrale
//
      L     #TD_press; // parametro derivativo in decimi di secondo

      T     #TD; 

      AN    #_FF_enable; 
      JC    M007; 
      L     #VM49_ff; 
      DTR   ; 
      L     2.000000e+00; 
      /R    ; 
      JU    M008; 
M007: L     0.000000e+00; 
M008: T     #R_ff_real_pr; 
NETWORK
TITLE =Calcolo del tempo di riesecuzione per FB41

      L     #K_tempo_exec; 
      DTR   ; 
      L     1.000000e+03; 
      /R    ; 
      T     #R_T_exec; 
NETWORK
TITLE =creazione bits di gestione PID
//
// ** creazione bit di hold integrale
//
      O     #_CIP_Rinse; 
//      O     #_Drain
      O     #_Start_up; 
      O     #_MA_Pressione; 
      ON    #_PID_enable; 
      O     #_drain_enable; 
      =     #Hold_int_PID; 
NETWORK
TITLE =reset integrali
//
// ** reset integrale PID
//
      O     #_CIP_Rinse; 
//      O     #_Drain
      O     #_Start_up; 
      O     #_MA_Pressione; 
      ON    #_PID_enable; 
      O     #_drain_enable; 
      =     #RES_int_PID; 
NETWORK
TITLE =

      O     #Hold_int_PID; 
      O     #RES_int_PID; 
      =     #MAN_ON; 
NETWORK
TITLE =resetto i manuali e seleziono lo stato di funzionamento

// Con MAN_ON = 0
      L     0.000000e+00; // 0.0 in offeset di uscita
      T     #R_LMN_OFF; 
      L     1.000000e+00; // 1.0 nel fattore moltiplicativo
      T     #R_LMN_FAC; 
// Con MAN_ON = 1

      AN    #MAN_ON; 
      JC    mend; 
      L     #R_Man_VM49; 
      A     #_MA_Pressione; 
      JC    man; 
      L     #R_VM49_drain; 
      A     #_drain_enable; 
      JC    man; 
      L     #VM49_start; 
      A     #_Start_up; 
      JC    man; 
      L     #VM49_cip_rinse; 
      A     #_CIP_Rinse; 
      JC    man; 
      L     0.000000e+00; 
man:  T     #R_LMN_OFF; 
      L     0.000000e+00; 
      T     #R_LMN_FAC; 
mend: NOP   0; 
NETWORK
TITLE =Richiamo blocco PID

      CALL FB    41 , DB    42 (
           COM_RST                  := FALSE,
           MAN_ON                   := #_MA_Pressione,
           PVPER_ON                 := TRUE,
           P_SEL                    := TRUE,
           I_SEL                    := TRUE,
           INT_HOLD                 := #Hold_int_PID,
           I_ITL_ON                 := #RES_int_PID,
           D_SEL                    := TRUE,
           CYCLE                    := #K_tempo_exec,
           SP_INT                   := #R_SP_PID,
           PV_PER                   := #PV_periph_c,
           MAN                      := #R_manual_value,
           GAIN                     := #R_KP,
           TI                       := #TI,
           TD                       := #TD,
           TM_LAG                   := T#0MS,
           DEADB_W                  := 2.000000e-03,// isteresi di blocco integrale
           LMN_HLM                  := 1.000000e+02,
           LMN_LLM                  := 0.000000e+00,
           PV_FAC                   := 1.000000e-01,// (10.0 bar) limite massimo trasduttore pressione
           PV_OFF                   := 0.000000e+00,
           LMN_FAC                  := #R_LMN_FAC,
           LMN_OFF                  := #R_LMN_OFF,
           I_ITLVAL                 := 0.000000e+00,
           DISV                     := #R_ff_real_pr,
           LMN                      := #R_out_pid,
           LMN_PER                  := #OUT_periph_VM49,
           PV                       := #R_PV_press);

NETWORK
TITLE =conversione da reale a intero delle variabili di uscita
// bargraph pid
      L     #R_out_pid; 
      TRUNC ; 
      T     #PC_OUT_VM49; 
NETWORK
TITLE =visualizzazione valore PV su PC

      L     #R_PV_press; 
      L     1.000000e+02; 
      *R    ; 
      TRUNC ; 
      T     #PV_press; 
NETWORK
TITLE =calcolo degli allarmi min max e ok
//
// **calcolo allarme di soglia massima
//
      L     #Max_press; 
      DTR   ; 
      L     1.000000e+01; 
      /R    ; 
      L     #R_PV_press; // se max livello > PV livello setto no allarme
      >=R   ; 
      =     #_Max_press; 

// **calcolo allarme di soglia minima

      L     #Min_press; 
      DTR   ; 
      L     1.000000e+01; 
      /R    ; 
      L     #R_PV_press; // semin livello < PV livello no allarme
      <=R   ; 
      =     #_Min_press; 

// **calcolo del segnale Livello OK

      L     #Ok_press; 
      DTR   ; 
      L     1.000000e+01; // converto la soglia in percentuale reale es 10 > 1.0
      /R    ; 
      L     #R_PV_press; 
      <=R   ; // se soglia < PV livello setto 1 il bit OK
      =     #_Ok_press; 
END_FUNCTION_BLOCK

