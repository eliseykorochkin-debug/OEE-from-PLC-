           PRES_BOTT_LAV_COLLO      := M     28.2,
           NUM_PASS_DURATA_LAV_BAGA := 6,
           EV_LAVAGGIO_COLLO        := "352K1");

// BLOCCO ELETTRONICO
      CALL "ELE BLOCCO 4" (
           STATO_B01_A34            := "A38_4",
           STATO_SANIF              := "PV TO PLC".STATUS_MACHINE,
           BLOCCO_BOTT_RIEMPITRICE  := "355Y1",
           MARCIA_A38               := "A38_1",
           EMERGENZA_A38            := "A38_2",
           BLOCCO_BOTT_A38          := "E21.4",
           MARCIA_NASTRO_USCITA_A53 := "A92_1",
           A38_PRONTA_AD_AUMENTO    := "A38_3",
           ARRESTO_IN_AUTO_ROTALLAR := "352K6",
           CONS_AUMENTO_VEL_X_A38   := "A20-A38_4",
           CONS_BLOCCO_BOTT_X_A38   := "A20-A38_3",
           CONS_MARCIA_X_A38        := "A20-A38_1",
           CONS_EMERG_XA38          := "A20-A38_2",
           MARCIA_MACCHINA_X_A53    := "A20-A92_1",
           BLOCCO_BOTT_APERTO_X_A53 := "A20-A92_2",
           EMERG_X_A53              := "A20-A92_3");

//GESTIONE POMPA DI SOVRAPPRESSIONE DEL MIXER
      CALL "OVER_PRESSURE_PUMP" (
           EV_BOTTLE_BLOCK          := "355Y1",
           OVER_PRESSURE_PUMP       := "A20-A33_1");

// PATTINO DI FLUSSAGGIO
