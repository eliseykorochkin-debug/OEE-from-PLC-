TITLE =Abilitazione allo screen saver

      A(    ; 
      L     "DATA_SET".ScreenSaver_modo; 
      L     0; 
      <>I   ; 
      )     ; 
      AN    "DATA_SET".com_puls_momentanei_8; 
      =     "DATA_SET".ScreenSaver_abilita; 

// tempo di ritardo attivazione a macchina ferma
      A     "DATA_SET".ScreenSaver_abilita; 
      AN    "350K1"; 
      L     "TIMER DATA SET".TIME110; 
      SD    T    110; 


      A     T    110; 
      S     "DATA_SET".ScreenSaver_attivo; 

      A     "DATA_SET".com_puls_momentanei_8; 
      ON    "DATA_SET".ScreenSaver_abilita; 
      R     "DATA_SET".ScreenSaver_attivo; 
//    R     T    110
NETWORK
TITLE =
//PER COMANDARE LA SCELTA DELLA PAGINA DA PLC:
//PAROLA DATI N   = TIPO DI PAGINA DA CARICARE
//PAROLA DATI N+2 = NUMERO DELL'ORDINE DEL CONTROLLORE
//PAROLA DATI N+3 = PARAMETRO 1 
//                  BYTE DI SINISTRA DISABILITAZIONE CURSORE (0:OFF 1:ON)
//                  BYTE DI DESTRA NUMERO DI PAGINA 0..99
//PAROLA DATI N+4 = PARAMETRO 2 NUMERO DI REGISTRAZIONE 0..99
//PAROLA DATI N+5 = PARAMETRO 3 NUMERO DI CAMPO 0..32 PER OP17
//                  0:CAMPO DEL NUMERO DI REGISTRAZIONE
//                  1:PRIMO CAMPO DI INTRODUZIONE
//                  :
//                  32:ULTIMO CAMPO DI INTRODUZIONE
//
//N = PRIMA PAROLA PER AREA DI INTERFACCIA IN QUESTO CASO N=DB10.DBW168
//Forzamento salto a pagina Screen saver
      A     "DATA_SET".ScreenSaver_attivo; 
      FP    M      2.7; 
      JCN   M009; 
      L     B#16#1; 
      T     "DATA_SET".SCREENSAVER_0; 
      L     B#16#33; //COMANDO 51 SCELTA PAGINA DA PLC A OP
      T     "DATA_SET".SCREENSAVER_02; //PAROLA DATI N+2
      L     B#16#35; //NUMERO DELLA PAGINA
      T     "DATA_SET".SCREENSAVER_03; //PAROLA DATI N+3 
      L     B#16#1; //NUMERO DEL CAMPO PER POSIZIONE CURSORE
      T     "DATA_SET".SCREENSAVER_04; //PAROLA DATI N+4
      JU    M010; 
//Forzamento salto a pagina Produzione
M009: A     "DATA_SET".ScreenSaver_attivo; 
      FN    M      4.0; 
      JCN   M010; 
      L     B#16#1; 
      T     "DATA_SET".SCREENSAVER_0; 
      L     B#16#33; //COMANDO 51 SCELTA PAGINA DA PLC A OP
      T     "DATA_SET".SCREENSAVER_02; //PAROLA DATI N+2
      L     B#16#A; //NUMERO DELLA PAGINA
      T     "DATA_SET".SCREENSAVER_03; //PAROLA DATI N+3 
      L     B#16#1; //NUMERO DEL CAMPO PER POSIZIONE CURSORE
      T     "DATA_SET".SCREENSAVER_04; //PAROLA DATI N+4
M010: NOP   0; 
END_FUNCTION

