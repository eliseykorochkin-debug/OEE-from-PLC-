  FF_to_pid : REAL ;	//valore di FF da sommare al PID
  KP : REAL ;	//K proporzionale
  TI : TIME ;	//T integrale
  TD : TIME ;	//T derivativo
  T_exec : REAL ;	//Tempo di riesecuzione per PID
  LMN_OFF : REAL ;	//offset valore di uscita
  LMN_FAC : REAL ;	//moltiplicativo valore uscita
  Hold_int_PID : BOOL ;	//hold dell'integrale PID
  RES_int_PID : BOOL ;	//Reset integrale PID FB41
  MAN_ON : BOOL ;	//manuale abilitato al PID
  Valve_open : BOOL ;	//segnale di valvole aperte 
  R_K_equilibrio : REAL ;	//valore reale della costante di equilibrio
  R_PC_freq_pompa : REAL ;	//valore reale frequenza pompa
  filler_speed_c : WORD ;	//valore velocita' macchina controllato
  USCITA_PID : REAL ;	
END_VAR
BEGIN
NETWORK
TITLE =verifica limiti ingressi analogici

      L     #Filler_speed; 
      L     W#16#7FFF; 
      >=I   ; 
      JC    ZER2; 
// 
      L     #Filler_speed; 
      L     0; 
      <=I   ; 
      JC    ZER2; 
      L     #Filler_speed; 
      L     27648; 
      >=I   ; 
      JC    VAL2; 
      TAK   ; 
      JU    VAL2; 
ZER2: L     0; 
VAL2: T     #filler_speed_c; 

NETWORK
TITLE =conversione costanti di ingresso da intere a reali
//
//
// ** trasforma il set point in valore reale

// ** trasforma il SP del livello in valore reale
      L     #SP_livello; 
      ITD   ; 
      DTR   ; 
      L     1.000000e+01; 
      /R    ; 
      T     #R_Set_point; 
// ** trasforma il PV della sonda in valore reale
      L     #PV_sonda; 
      L     27648; 
      >=I   ; 
      JCN   SOND; 
      L     27648; 
      JU    SON1; 
SOND: L     #PV_sonda; 
SON1: NOP   0; 
      ITD   ; 
      DTR   ; 
      L     2.764800e+02; 
      /R    ; 
      T     #R_PV_sonda; 

//
// ** trasformo la costante di recupero in reale
      L     #K_recupero; 
      ITD   ; 
      DTR   ; 
      L     1.000000e+04; 
      /R    ; 
      T     #R_K_recupero; 
//
// ** trasformo la costante di reset integrale FF
      L     #K_reset_int; 
      DTR   ; 
      T     #R_K_reset_int; 
//
// ** trasformo la costante della rampa ingresso bottiglie
      L     #K_rampa; 
      DTR   ; 
      T     #R_K_rampa; 
//
// ** trasformo la costante VM1_start
      L     #VM1_start; 
      DTR   ; 
      T     #R_VM1_start; 
//
// ** trasformo il valore di forzamento manuale
      L     #Man_livello; 
      DTR   ; 
      T     #R_Man_livello; 

// ** trasformo il valore di apertura VM1 in cip
      L     #Open_VM1_CIP_W; 
      DTR   ; 
      T     #Open_VM1_CIP; 

// ** trasformo il valore di apertura VM1 in drenaggio
      L     #Open_VM1_Drain_W; 
      DTR   ; 
      T     #Open_VM1_drain; 


//
// ** trasformo il valore di velocit� riempitrice
      L     #filler_speed_c; 
      DTR   ; 
      L     2.764800e+04; 
      /R    ; 
      T     #R_Filler_speed; 
NETWORK
TITLE =conversione parametri PID da intero a reale 
//
// ** calcolo il fattore proporzionale
// controllo che i valori non siano minori di 1 (uno).
      L     #BP_livello; // trasferisco parametro proporzionale
      L     1; 
      <I    ; 
      JC    s300; 
      L     #BP_livello; // trasferisco parametro proporzionale
s300: DTR   ; 
      T     #R_temp1; // eseguo l'operazione 100 / PB
      L     1.000000e+03; 
      L     #R_temp1; 
      /R    ; 
      T     #KP; 
//
// ** calcolo del fattore integrale
// controllo che i valori non siano minori di 1 (uno).
      L     #TI_livello; // parametri integrale in secondi 
      L     1; 
      <I    ; 
      JC    s301; 
      L     #TI_livello; // trasferisco parametro proporzionale
s301: L     10; 
      *D    ; // * 10 -> trasformo in tempo siemmens mS 
      T     #TI; 
//
// ** calcolo del fattore integrale
// controllo che i valori non siano minori di 1 (uno).
      L     #TD_livello; // parametro derivativo in decimi di secondo
      L     1; 
      <I    ; 
      JC    s302; 
      L     #TD_livello; // trasferisco parametro proporzionale
s302: T     #TD; 
NETWORK
TITLE =Calcolo del tempo di riesecuzione per FB41

      L     #K_tempo_exec; 
      DTR   ; 
      L     1.000000e+03; 
      /R    ; 
      T     #T_exec; 
NETWORK
TITLE =creazione bits di gestione PID
//
// ** creazione bit di hold integrale
      O     #_CIP_Rinse; 
      O     #_Drain; 
      O     #_Start_up; 
      O     #_MA_livello; 
      ON    #_PID_enable; 
      ON    #_FF_enable; 
      =     #Hold_int_PID; 
NETWORK
TITLE =reset integrali
//
// ** reset integrale PID e FF
//
      O     #_CIP_Rinse; 
      O     #_Drain; 
      O     #_Start_up; 
      O     #_MA_livello; 
      ON    #_FF_enable; 
      JC    IRES; 
//
// ** non resetta l'integrale( 0 = non resettato )
      R     #RES_int_PID; 
      JU    M500; 
//
IRES: NOP   0; 
//
// ** resetta l'integrale( 1 = resettato )
      S     #RES_int_PID; 
      L     #R_K_reset_int; 
      T     #R_int_recupero; 
//
M500: NOP   0; 
NETWORK
TITLE =resetto i manuali e seleziono lo stato di funzionamento

      L     0.000000e+00; // LMN_OFF e LMN_FAC nelle 
      T     #LMN_OFF; // condizioni nominali di 
      L     1.000000e+00; // produzione
      T     #LMN_FAC; 
//
      L     #R_Man_livello; 
      A     #_MA_livello; // apertura valvola in manuale PC
      JC    SMAN; 
// 270801
//      U     #_Drain                     // apertura valvola in drenaggio
//      L     #Open_VM1_drain
//      SPB   SMAN
//
      L     #Open_VM1_CIP; 
      A     #_CIP_Rinse; // apertura valvola in CIP
      JC    SMAN; 
//                                       //apertura valvola in Start up se
//                                       //livello non ancora raggiunto
      L     #R_VM1_start; 
      A     #_Start_up; 
      A     #_PID_enable; 
      AN    #_Livello_OK; 
      JC    SMAN; 
// 270801
      L     0.000000e+00; 
      AN    #_PID_enable; // se non ho l'abilitazione del PID
      JC    SMAN; 
//
      JU    MEND; 
//
SMAN: T     #LMN_OFF; 
      L     0.000000e+00; // 0.0 nel fattore moltiplicativo
      T     #LMN_FAC; 
//
MEND: NOP   0; 
NETWORK
TITLE =calcolo rampa per ff
// se flag ff_enable non vero salta
      AN    #_FF_enable; 
      JC    RFF4; 
//
      AN    #End_rampa; // se ho raggiunto il fine rampa
      JC    RFF1; 
//
      L     #FF_value; // mantengo aggiornato Il valore R_valore_rampa
      T     #R_valore_rampa; // con il valore del FF rilevato dal calcolo
      JU    RFF5; 
//
RFF1: NOP   0; 
      L     #FF_value; 
      L     #R_valore_rampa; 
      >R    ; 
      JC    RFF2; // se raggiunto FF 
      S     #End_rampa; // setto il falg di fine rampa
      JU    RFF5; 
//
RFF2: NOP   0; 
      L     #R_K_rampa; // se non ho ancora raggiunto FF 
      L     #T_exec; // incremento R_valore_rampa di K rampa * T exec
      *R    ; // finch� superiore al FF calcolato
      L     #R_valore_rampa; 
      +R    ; 
      T     #R_valore_rampa; 
      JU    RFF5; 
//
RFF4: NOP   0; 
      R     #End_rampa; // resetta il flag end rampa
//
      L     #R_valore_rampa; // se valore rampa > 0
      L     0.000000e+00; 
      <=R   ; 
      JC    RFF5; 
//
      L     #R_K_rampa; // decrementa il valore rampa del valore 
      L     #T_exec; // Krampa * Tempo ripetizione

      *R    ; 
      L     #R_valore_rampa; 
      TAK   ; 
      -R    ; 
      T     #R_valore_rampa; 
//
RFF5: NOP   0; 
      L     #R_valore_rampa; 
      T     #FF_to_pid; 


NETWORK
TITLE =Richiamo blocco PID

      CALL FB    41 , "Db_istanza_FB41" (
           COM_RST                  := FALSE,
           MAN_ON                   := #_MA_livello,
           PVPER_ON                 := FALSE,
           P_SEL                    := TRUE,
           I_SEL                    := TRUE,
           INT_HOLD                 := #Hold_int_PID,
           I_ITL_ON                 := #RES_int_PID,
           D_SEL                    := TRUE,
           CYCLE                    := T#200MS,
           SP_INT                   := #R_Set_point,
           PV_IN                    := #R_PV_sonda,
           MAN                      := 0.000000e+00,
           GAIN                     := #KP,
           TI                       := #TI,
           TD                       := #TD,
           TM_LAG                   := T#0MS,
           DEADB_W                  := 0.000000e+00,
           LMN_HLM                  := 1.000000e+02,
           LMN_LLM                  := -1.000000e+02,// old 0
           PV_FAC                   := 1.000000e+00,
           PV_OFF                   := 0.000000e+00,
           LMN_FAC                  := #LMN_FAC,
           LMN_OFF                  := #LMN_OFF,
           I_ITLVAL                 := 0.000000e+00,
           DISV                     := #FF_to_pid,
           LMN                      := #USCITA_PID,
           PV                       := #R_PV_livello);

NETWORK
TITLE =

      L     0; 
      L     #USCITA_PID; 
      <R    ; 
      JC    SA01; 
      L     0; 
SA01: T     #R_out_pid; 
      L     2.764800e+02; 
      *R    ; 
      TRUNC ; 
      T     #OUT_periph_VM1; 
NETWORK
TITLE =ritardo per abilitazione ricalcolo integrale FF 

      A     #_FF_enable; 
      JC    CI01; 
//
      L     #Delay_FF_calc; // setta la variabile al valore di ritardo
      T     #Delay_var; 
      R     #FF_calc_enable; // resetta Il flag di calcolo FF
      JU    CI02; 
//
CI01: NOP   0; 
//
      A     #FF_calc_enable; // se flag gia settato non decrementa
      JC    CI02; 
//
      L     #Delay_var; // decrementa la variabile Delay_var
      L     #T_exec; // del tempo di riesecuzione
      -R    ; 
      T     #Delay_var; 
      L     0.000000e+00; 
      <R    ; 
      S     #FF_calc_enable; // se Delay var < 0 setto il flag
//
CI02: NOP   0; 
NETWORK
TITLE =Calcolo FF

      AN    #FF_calc_enable; 
      ON    #End_rampa; 
      JC    FF11; 
//
      L     #R_out_pid; // uscita PID

      L     #FF_value; // - FF
      -R    ; 
      L     #R_K_recupero; // * K recupero
      *R    ; 
      L     #R_int_recupero; // lo sommo all'integrale
      +R    ; // gia calcolato 
      T     #R_int_recupero; 
FF11: L     #R_int_recupero; 
      L     #R_Filler_speed; // moltiplico per filler speed
      *R    ; 
// modi pompa
      L     0.000000e+00; 
      >R    ; 
      JC    OKVA; 
      T     #FF_value; 
      JU    FF03; 
OKVA: TAK   ; 
// modi pompa
      T     #FF_value; // trasferisco nella var FF_value
//
FF03: NOP   0; 
NETWORK
TITLE =calcolo degli allarmi min max e livello ok
//
// **calcolo allarme di soglia massima
//
      L     #Max_livello; 
      DTR   ; 
      L     1.000000e+01; 
      /R    ; 
      L     #R_PV_livello; // se max livello > PV livello setto no allarme
      >=R   ; 
      =     #_Max_livello; 
//
// **calcolo allarme di soglia minima
//
      L     #Min_livello; 
      DTR   ; 
      L     1.000000e+01; 
      /R    ; 
      L     #R_PV_livello; // semin livello < PV livello no allarme
      <=R   ; 
      =     #_Min_livello; 
//
// **calcolo del segnale Livello OK
//
      L     #Livello_OK; 
      DTR   ; 
      L     1.000000e+01; // converto la soglia in percentuale reale es 10 > 1.0
      /R    ; 
      L     #R_PV_livello; 
      <=R   ; // se soglia < PV livello setto 1 il bit OK
      =     #_Livello_OK; 
NETWORK
TITLE =conversione da reale a intero delle variabili di uscita

      L     #R_out_pid; 
      TRUNC ; 
      T     #OUT_PC_VM1; 
NETWORK
TITLE =VALORE CALCOLATO FF
//
//
      L     #FF_value; 
      TRUNC ; 
      T     #OUT_FF; 
NETWORK
TITLE =VALORE PV_LIVELLO PER PC

      L     #R_PV_livello; 
      L     1.000000e+01; 
      *R    ; 
      TRUNC ; 
      T     #PV_livello; 
END_FUNCTION_BLOCK

