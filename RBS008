// sottraggo il valore di uscita del PID a 50% e lo moltiplico *2
// per ottimizzare la risoluzione.
// (VM2=(R_OUT_PID-50)*2)

M016: NOP   0; 
      -R    ; 
      L     2.000000e+00; 
      *R    ; 
      T     #R_Out_VMin; 
      L     0.000000e+00; 
      T     #R_Out_VMout; 

// CONTROLLO ANALOGICHE VALVOLE CONTROPRESSIONE E SFIATO
