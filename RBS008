           LIVELLO_GRASSO_TANK      := "303S7",
           NUM_DI_RUBINETTI         := 72,
           EV_POMPA_LUBRIFICANTE    := "354Y8");

// Screen saver
      UC    "screen saver"; 
NETWORK
TITLE =ABILITAZIONE AI SOLLEVAMENTI

//ABILITAZIONE AI SOLLEVAMENTI
