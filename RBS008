FUNCTION "FBK _MOTOR" : VOID
TITLE =ALLARME POSIZIONAMENTO VALVOLE
VERSION : 0.1


VAR_INPUT
  START_MOTOR : BOOL ;	//MARCIA MOTORE
  FBK_MOTOR : BOOL ;	//FBK MOTORE
  TIME_BASE : BOOL ;	//CLOCK DI BASE PER IL CONTEGGIO DEL TEMPO
END_VAR
VAR_IN_OUT
  SETM : WORD ;	//VALORE DI TEMPO DEL CONTROLLO
  ALARM_TIME : BOOL ;	//ALLARME ANOMALIA MOTORE
END_VAR
BEGIN
NETWORK
TITLE =RICHIAMO DB E APPOGGIO TEMPO IN AREA DI LAVORO

      OPN   "FBK_MOTOR_DATA_TIMER"; 
      L     #SETM; 
      T     DBW    0; 
NETWORK
TITLE =
//CONDIZIONE DI ABILITAZIONE AL CONTEGGIO DI CONTROLLO DEL MOTORE DA CONTROLLARE.
//


      A(    ; 
      A     #START_MOTOR; 
      AN    #FBK_MOTOR; 
      O     ; 
      AN    #START_MOTOR; 
      A     #FBK_MOTOR; 
      )     ; 
      AN    #ALARM_TIME; 
      JC    S001; 
NETWORK
TITLE =
//SE NON HO L'ABILITAZIONE (CONDIZIONE DI ALLARME) NON CONTO E MANTENGO RESETTATO 
//L'ALLARME DEL MOTORE CORRISPONDENTE.
//SE HO LA CONDIZIONE DI ALLARME QUESTO SEGMENTO NON VIENE ELABORATO.
      A     #ALARM_TIME; 
      A     "108K2"; 
      R     #ALARM_TIME; 

      A     #ALARM_TIME; 
      JC    s004; 
      L     0; 
      T     DBB    1; 
      L     DBW    0; 
      T     #SETM; 
s004: NOP   0; 

      JU    S002; 
NETWORK
TITLE =
//QUESTO SEGMENTO LAVORA SOLO SE LA CONDIZIONE DI ALLARME O IL MOTORE HA DEI 
//PROBLEMI.
//
//DBB0 = PRESET 
//DBB1 = ACCUMULATORE DI CONTEGGIO
//TIME_BASE = BASE DEL TEMPO 
//

S001: L     DBB    1; 
      L     DBB    0; 
      >=I   ; 
      JC    S003; 
      R     #ALARM_TIME; 
      AN    #TIME_BASE; 
      JC    S002; 
      L     DBB    1; 
      INC   1; 
      T     DBB    1; 
      L     DBB    0; 
      <I    ; 
      L     DBW    0; 
      T     #SETM; 
      JC    S002; 
NETWORK
TITLE =
//SE HO FINITO IL CONTEGGIO SETTO L'ALLARME ALTRIMENTI ESCO DALLA PROCEDURA.
S003: S     #ALARM_TIME; 
S002: NOP   0; 
END_FUNCTION

